[Unit]
Description=PixelPlein Kiosk Browser
Conflicts=getty@tty1.service
After=systemd-user-sessions.service network.target pixelplein-agent.service
Wants=pixelplein-agent.service

[Service]
User=pixelplein
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TimeoutStopSec=5
KillMode=control-group
Environment=PIXELPLEIN_KIOSK_BACKEND=wayland
Environment=XDG_SESSION_TYPE=wayland
ExecStart=systemd-inhibit --what=idle:sleep:handle-lid-switch --who=pixelplein-kiosk --why="Kiosk display must stay on" /opt/pixelplein/tools/pixelplein-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
